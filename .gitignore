# Raw bid sets and intermediate extraction artifacts - large, not version controlled
projects/*/uploads/raw/
projects/*/uploads/processed/

# Approved quotations ARE version controlled:
!projects/*/uploads/final/
# Audit trails ARE version controlled:
!projects/*/audit_trail.jsonl

# Secrets / local overrides (P21 credentials)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# App
.env
web/.env.local
web/.next/
web/node_modules/
storage/

# Rendered PDF page cache
.cache/

# The catalog search index: derived from pricebooks/, rebuilt with
# `python -m catalog_index.rebuild`. Never the source of truth.
.index/

# Terminal recordings of Claude Code runs - large, regenerated per run
projects/*/.runs/

# Artifact-storage SHA history - runtime only
projects/*/.versions/

# Test scratch workspaces
tests/fixtures/scratch/
tests/fixtures/projects/.runs/

# Local/dev bid workspaces (committed demo: dutch_bros_macarthur_2026;
# frozen fixtures live under tests/fixtures/projects/)
projects/adv_test_*/
projects/assign_test*/
projects/bid_*/
projects/burger_king_2379_test/
projects/collision_one/
projects/collision_two/
projects/no_initiator_bid/
projects/other_bid/
projects/ordinary_work/
projects/phase_two_test_bid/
projects/terminal_probe_one_page/
projects/test/
projects/verify/

# Bootstrap artifacts and local PDF copies (canonical copies under docs/bootstrap/ and tests/fixtures/pdfs/)
BUILD_PROMPT.md
CBC_Req_Validation_v1_3.xlsx
cbc_copilot_project_structure.md
building-plans/

# The audit hook writes projects/{project}/audit_trail.jsonl. Running with no
# project in scope makes it fall back to the repo root, leaving a stray here that
# is session noise rather than a record of a bid. The negation above still keeps
# the real per-project trails tracked.
/audit_trail.jsonl
