# Copy to `.env` at the repo root (API + worker) and to `web/.env.local`
# (Next.js), then fill in. `.env` is gitignored.
#
# `docker compose` interpolates this file for the values it injects. Provider
# credentials (Bedrock API key, Anthropic key, …) are NOT injected that way —
# Settings writes them into this file, and the worker rereads it on every job.
# Create the file before `docker compose up`: if `.env` is missing Docker
# mounts a directory at `/app/.env` and Save cannot write the key.
#
# Copy:
#     cp .env.example .env
#     cp .env.example web/.env.local   # then keep only the Next.js block there

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://cbc:cbc_local_dev@localhost:27017/cbc_opshub?authSource=admin
MONGODB_DB=cbc_opshub
# docker-compose seeds the root user from this. Change it anywhere real.
MONGO_ROOT_PASSWORD=cbc_local_dev
# Optional. The catalog MCP and page index use a read-only user; the worker
# creates one when this is unset.
# MONGODB_READONLY_URI=
# MONGODB_READONLY_PASSWORD=cbc_catalog_ro_local_dev

# ── Paths ───────────────────────────────────────────────────────────────────
# Repo root. Bid-set PDFs live under {REPO_ROOT}/projects/{slug}/uploads/raw/
REPO_ROOT=.
STORAGE_ROOT=./projects
PRICEBOOK_DIR=./pricebooks
REFERENCE_DIR=./reference-library
TEMPLATES_DIR=./templates
# The catalog index is the `pageIndex` collection in MongoDB — no file, no path.

# ── Bootstrap ───────────────────────────────────────────────────────────────
# docker/entrypoint.sh runs scripts/bootstrap.py on start when this is 1.
# Set to 0 to skip the automatic seed and PageIndex build on container start.
AUTO_BOOTSTRAP=1

# ── P21 (read-only cost lookup — NR-10) ─────────────────────────────────────
# Leave unset until IT confirms endpoint and auth. Connector returns manual entry.
# P21_BASE_URL=
# P21_API_KEY=
# P21_LOOKUP_PATH=/api/items/{part_number}/last-po
# P21_SEARCH_PATH=/api/items/search
# P21_TIMEOUT_SECONDS=15

# ── Claude Code CLI (worker) ────────────────────────────────────────────────
CLAUDE_BIN=claude
WORKER_POLL_SECONDS=5
# A 30-page CAD set is minutes of LLM work. Compose default is 3600.
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_MAX_ATTEMPTS=3
WORKER_MAX_TURNS=60
WORKER_RETRY_BASE_SECONDS=30
WORKER_PIPELINE_TIMEOUT_SECONDS=10800
WORKER_PIPELINE_MAX_TURNS=200
# Jobs this process may run at once. 1 keeps the historic serial worker.
WORKER_CONCURRENCY=1
PIPELINE_DEBOUNCE_SECONDS=60

# Host Ollama URL when api/worker run in Docker (default: host.docker.internal:11434).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Extra hosts ANTHROPIC_BASE_URL may point at, comma-separated.
# ALLOWED_PROVIDER_HOSTS=

# ── Amazon Bedrock / Claude Code provider ───────────────────────────────────
# Prefer Settings → Claude Code: Save writes these into this file (chmod 600)
# and Mongo. Do not also export them in the process environment unless you
# want the matching field locked as "set by environment" (Fargate does that
# on purpose via the task role).
#
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=ap-south-1
# AWS_BEARER_TOKEN_BEDROCK=
# ANTHROPIC_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# ANTHROPIC_DEFAULT_HAIKU_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_BEDROCK_REGION_PREFIX=global
#
# Other modes (leave unset unless that provider is the one in Settings):
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# CLAUDE_CODE_OAUTH_TOKEN=
#
# ── Cloudflare AI Gateway / Workers AI ──────────────────────────────────────
# Prefer Settings → Claude Code → Cloudflare: Save constructs these from
# account ID (+ gateway ID for AI Gateway routes) + token.
#
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=
# CLOUDFLARE_AIG_TOKEN=
# CLOUDFLARE_WORKERAI_API_TOKEN=   # alias for CLOUDFLARE_AIG_TOKEN on Workers AI
# CLOUDFLARE_ROUTE=anthropic
# ANTHROPIC_CUSTOM_HEADERS=cf-aig-authorization: Bearer <CLOUDFLARE_AIG_TOKEN>
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT>/<GATEWAY>/anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# Bedrock via Gateway (no AWS keys):
# CLOUDFLARE_ROUTE=bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_SKIP_BEDROCK_AUTH=1
# ANTHROPIC_BEDROCK_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT>/<GATEWAY>/aws-bedrock/bedrock-runtime/us-east-1/
#
# Vertex via Gateway:
# CLOUDFLARE_ROUTE=vertex
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_SKIP_VERTEX_AUTH=1
# ANTHROPIC_VERTEX_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT>/<GATEWAY>/google-vertex-ai/v1
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=us-east5
#
# Workers AI (free @cf models via the built-in bridge — leave ANTHROPIC_BASE_URL unset):
# CLOUDFLARE_ROUTE=workers
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AIG_TOKEN=            # or CLOUDFLARE_WORKERAI_API_TOKEN=
# ANTHROPIC_MODEL=@cf/moonshotai/kimi-k2.7-code
# WORKERS_AI_BRIDGE_URL=http://workers-ai-bridge:8787   # Compose default; local: http://127.0.0.1:8787
# Optional custom Anthropic-compatible bridge instead of the built-in one:
# ANTHROPIC_BASE_URL=https://claude-bridge.example.workers.dev

# Optional: Claude Code subscription credentials file for local compose.
# CLAUDE_CREDENTIALS=~/.claude/.credentials.json

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001
API_BASE_URL=http://127.0.0.1:8001
# Loopback only. Set 0.0.0.0 only when something off-box must call the API.
API_BIND=127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Maximum bid-document upload size accepted by the API (MB). The web proxy limit
# in web/next.config.ts should match this value.
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
# LOG_FORMAT=json

# Shared between the Next.js proxy and FastAPI. Defaults to APP_SECRET_KEY in dev.
#
# These three, MONGO_ROOT_PASSWORD and AUTH_SECRET are checked at startup: with
# APP_ENV=production (or prod/staging) the API and the web tier both refuse to
# start while any of them still holds the value printed here. Generate real ones:
#     openssl rand -base64 32
INTERNAL_API_TOKEN=cbc-local-dev-key-change-me
APP_SECRET_KEY=cbc-local-dev-key-change-me
APP_ENV=development

# ── Next.js (web/.env.local) ────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET=cbc-opshub-local-dev-secret-change-in-production
# AUTH_TRUST_HOST=true
# API_BASE_URL=http://127.0.0.1:8001
# INTERNAL_API_TOKEN=cbc-local-dev-key-change-me
# APP_ENV=development
# E2E_ESTIMATOR_EMAIL=estimator@cbc.com
# E2E_ESTIMATOR_PASSWORD=opshub
# E2E_ADMIN_EMAIL=admin@cbc.com
# E2E_ADMIN_PASSWORD=opshub
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
