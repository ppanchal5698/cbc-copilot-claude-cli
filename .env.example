# Copy to .env (api + worker) and web/.env.local (Next.js), then fill in.

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://cbc:cbc_local_dev@localhost:27017/cbc_opshub?authSource=admin
MONGODB_DB=cbc_opshub

# ── Paths ───────────────────────────────────────────────────────────────────
# Repo root. Bid-set PDFs live under {REPO_ROOT}/projects/{slug}/uploads/raw/
REPO_ROOT=.
STORAGE_ROOT=./projects

# ── Claude Code CLI (worker) ────────────────────────────────────────────────
CLAUDE_BIN=claude
WORKER_POLL_SECONDS=5
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_MAX_ATTEMPTS=3

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000

# ── Next.js (web/.env.local) ────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
# API_BASE_URL=http://127.0.0.1:8000
