# Data is mounted, not baked. pricebooks/ is 56 MB and projects/ is 336 MB;
# copying them into the image would make every build slow and every layer stale
# the moment an estimator uploads a drawing.
projects/
pricebooks/
final_pricebooks/
building-plans/
frontend/

.git/
.venv/
venv/
**/__pycache__/
**/*.py[co]
.pytest_cache/
.cache/

web/node_modules/
web/.next/
web/out/

.env
.env.local
web/.env.local
.claude/settings.local.json

*.md
!CLAUDE.md
!docs/*.md
